/* 调色板：Python 侧取色用（图标 / 自绘 / 状态文字）。规则里的颜色仍是字面量，
   改色时两边一起看；规范见 src/utils/palette.py。 */
/*<colors>
brand:      #f0b731
panel:      rgb(229, 228, 228)
panel_alt:  rgb(245, 245, 245)
text:       rgb(0, 0, 0)
text_dim:   rgb(59, 59, 59)
line:       rgb(189, 189, 189)
danger:     #e06c6c
warn:       #d8b64a
ok:         #4a9a4a
icon:       #787878
icon_strong:#161616
scrim:      #78000000
</colors>*/

* {outline: none;}
QWidget {
    background: rgb(245, 245, 245);
}
QWidget[wid="panel-alt"] {
    background: rgb(229, 228, 228);
}
/* 纯布局容器：不画自己的底，露出宿主面板（深色主题同一处理） */
QWidget[wid="plain"] {
    background: transparent;
}
QWidget[wid="line"] {
    background: rgb(189, 189, 189)
}
QWidget[wid="shadow"] {
    background: qlineargradient(
        x1: 1, y1: 0, x2: 0, y2: 0,
        stop: 0 rgba(245, 245, 245, 0),
        stop: 0.5 rgba(245, 245, 245, 0.5),
        stop: 1 rgba(245, 245, 245, 1)
    );
}
QLabel {
    background: transparent;
    border: none;
}
QLabel[wid="title"] {
    background: transparent;
    border: none;
    color: rgb(59, 59, 59);
}
QLabel[wid="btn-text"] {
    background: transparent;
    border: none;
    color: rgb(59, 59, 59);
}
QLabel[wid="image"] {
    background: rgb(245, 245, 245);;
    border: 3px solid #8f8f8f;
}
QLabel[wid="text"] {
    background: transparent;
    border: none;
    color: rgb(0, 0, 0);
}
QTextBrowser[wid="text"] {
    background: transparent;
    border: none;
    color: rgb(0, 0, 0);
}
QTextEdit[wid="console"] {
    border: none;
    font-family: Consolas, 'Courier New', monospace;
    font-size: 12px;
}
QPushButton[wid="btn"] {
    background: transparent;
    border: 1px solid rgb(59, 59, 59);
    border-radius: 5px;
    color: rgb(22, 22, 22);
    font-size: 12px;
}
QPushButton[wid="btn"]:pressed {
    background: rgba(124, 124, 124, 0.1);
    border: 1px solid rgb(124, 124, 124);
}
QPushButton[wid="btn"]:disabled{
    color:#888;
    background:rgba(0, 0, 0, 0.171);
}
QPushButton[wid="btn-text"] {
    background: transparent;
    border: none;
}
QPushButton[wid="btn-text"]:hover {
    background: rgba(124, 124, 124, 0.2);
    border: none;
}
QPushButton[wid="btn-text"]:checked {
    background: rgba(124, 124, 124, 0.5);
    border: none;
}
QPushButton[wid="btn-tool"] {
    background: transparent;
    border: none;
}
QPushButton[wid="btn-tool"]:hover {
    background: rgba(124, 124, 124, 0.2);
    border: none;
}
QPushButton[wid="btn-tool"]:checked {
    background: rgba(124, 124, 124, 0.5);
    border: none;
}
QLineEdit[wid="input"] {
    background: rgb(255, 255, 255);
    border: 1px solid rgb(179, 179, 179);
    border-radius: 5px;
    color: rgb(0, 0, 0);
    font-size: 12px;
    padding: 2px 8px;
}
QLineEdit[wid="input"]:focus {
    border: 1px solid rgb(110, 65, 151);
}
QProgressBar[wid="progress"] {
    background: rgb(255, 255, 255);
    border: 1px solid rgb(179, 179, 179);
    border-radius: 4px;
    text-align: center;
    color: rgb(59, 59, 59);
    font-size: 10px;
}
QProgressBar[wid="progress"]::chunk {
    background: rgba(240, 183, 49, 0.8);
    border-radius: 3px;
}
QLabel[wid="badge"] {
    background: rgba(110, 65, 151, 0.15);
    border: 1px solid rgba(110, 65, 151, 0.4);
    border-radius: 4px;
    color: rgb(90, 45, 130);
    font-size: 11px;
    padding: 2px 8px;
}
QPushButton[wid="btn-check"] {
    background: transparent;
    border: none;
}
QMenu {
    background: #f0f0f0;
    color: #383838
}
QMenu::item {
    color: #383838
}
QMenu::item:selected {
    background: #d3d3d3;
}
QStackedWidget[wid="stack"] {
    background: rgb(245, 245, 245);
}
QToolTip { 
    background: rgb(245, 245, 245);
    color: rgb(29, 29, 29);
    border: 1px solid rgb(117, 117, 117);
    border-radius: 1px;
}
QSlider::groove:horizontal[wid="slider"] {
    background: transparent;
    border: 3px solid gray;
}
QSlider::handle:horizontal[wid="slider"] {
    background: gray;
    width: 20px;
}
QComboBox {
    background: rgb(245, 245, 245);
    color: rgb(56, 56, 56);
    border: 1px solid rgb(189, 189, 189);
    border-radius: 2px;
    padding: 4px 24px 4px 8px;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 15px;
}
QComboBox QAbstractItemView {
    background: rgb(240, 240, 240);
    color: rgb(56, 56, 56);
    border: 1px solid rgb(189, 189, 189);
    outline: none;
}
QComboBox QAbstractItemView::item:hover {
    background: rgba(124, 124, 124, 0.2);
}
QComboBox QAbstractItemView::item:selected {
    background: rgba(124, 124, 124, 0.5);
}
QScrollBar:vertical {
    background: transparent;
    width: 5px;
    margin: 0;
}
QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-line:vertical {
    height: 0px;
}
QScrollBar::handle:vertical {
    min-height: 60px;
    background: #888;
    border-radius: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #aaa;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}
QScrollBar:horizontal {
    background: transparent;
    height: 5px;
    margin: 0;
}
QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-line:horizontal {
    width: 0px;
}
QScrollBar::handle:horizontal {
    min-width: 60px;
    background: #888;
    border-radius: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: #aaa;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}
